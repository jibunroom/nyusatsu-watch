# コード・リポジトリに秘密情報を一切書かない（§8-3）
# ローカル実行時のみ .env を作ってここに値を入れる。.env は .gitignore 済み。

# Gemini（このシステム専用プロジェクトの無料ティア鍵）
GEMINI_API_KEY=
# 既定は config/settings.yml の gemini.default_model。2.0系は停止済み
GEMINI_MODEL=gemini-flash-latest

# お名前.com SMTP（§5-2）
SMTP_HOST=mail65.onamae.ne.jp
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 通知先（個人Gmail）。User-Agent の contact にも使われる（§9）
MAIL_TO=
